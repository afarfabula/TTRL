(0, 0, 1))\n                    elif a_over_4_plus_b_over_2 == -2:\n                        solutions.append((-4, 4, 1))\n                    elif a_over_4_plus_b_over_2 == 2:\n                        solutions.append((4, -4, 1))\n                elif a_plus_b == -2:\n                    if a_over_4_plus_b_over_2 == 0:\n                        solutions.append((-2, 0, 1))\n                    elif a_over_4_plus_b_over_2 == -2:\n                        solutions.append((-6, 4, 1))\n                    elif a_over_4_plus_b_over_2 == 2:\n                        solutions.append((2, -4, 1))\n                elif a_plus_b == 2:\n                    if a_over_4_plus_b_over_2 == 0:\n                        solutions.append((2, 0, 1))\n                    elif a_over_4_plus_b_over_2 == -2:\n                        solutions.append((6, -4, 1))\n                    elif a_over_4_plus_b_over_2 == 2:\n                        solutions.append((-2, 4, 1))\n            elif c_val == -1:\n                if a_plus_b == 2:\n                    if a_over_4_plus_b_over_2 == 0:\n                        solutions.append((2, 0, -1))\n                    elif a_over_4_plus_b_over_2 == -2:\n                        solutions.append((6, -4, -1))\n                    elif a_over_4_plus_b_over_2 == 2:\n                        solutions.append((-2, 4, -1))\n                elif a_plus_b == 0:\n                    if a_over_4_plus_b_over_2 == 0:\n                        solutions.append((0, 0, -1))\n                    elif a_over_4_plus_b_over_2 == -2:\n                        solutions.append((-4, 4, -1))\n                    elif a_over_4_plus_b_over_2 == 2:\n                        solutions.append((4, -4, -1))\n                elif a_plus_b == -2:\n                    if a_over_4_plus_b_over_2 == 0:\n                        solutions.append((-2, 0, -1))\n                    elif a_over_4_plus_b_over_2 == -2:\n                        solutions.append((-6, 4, -1))\n                    elif a_