1}^n a_i^2 \\right) \\left( \\sum_{i=1}^n b_i^2 \\right).\n   \\]\n   If we set \\(a_i = a_i\\) and \\(b_i = 1\\), we get\n   \\[\n   \\left( \\sum_{i=1}^n a_i \\right)^2 \\leq n \\left( \\sum_{i=1}^n a_i^2 \\right).\n   \\]\n   Substituting the given values, we have\n   \\[\n   96^2 \\leq n \\cdot 144 \\implies 9216 \\leq 144n \\implies n \\geq \\frac{9216}{144} = 64.\n   \\]\n\n2. **Using the Power Mean Inequality:**\n   The power mean inequality states that for positive real numbers \\(a_i\\),\n   \\[\n   \\left( \\frac{1}{n} \\sum_{i=1}^n a_i^k \\right)^{1/k} \\geq \\left( \\frac{1}{n} \\sum_{i=1}^n a_i^m \\right)^{1/m} \\text{ for } k > m.\n   \\]\n   For \\(k=3\\) and \\(m=2\\), we have\n   \\[\n   \\left( \\frac{1}{n} \\sum_{i=1}^n a_i^3 \\right)^{1/3} \\geq \\left( \\frac{1}{n} \\sum_{i=1}^n a_i^2 \\right)^{1/2}.\n   \\]\n   Substituting the given values, we get\n   \\[\n   \\left( \\frac{216}{n} \\right)^{1/3} \\geq \\left( \\frac{144}{n} \\right)^{1/2}.\n   \\]\n   Simplifying this inequality, we get\n   \\[\n   \\left( \\frac{216}{n} \\right)^{1/3} \\geq \\left( \\frac{144}{n} \\right)^{1/2} \\implies \\left( \\frac{216}{n} \\right)^2 \\geq \\left( \\frac{144}{n} \\right)^3 \\implies \\frac{216^2}{n^2} \\geq \\frac{144^3}{n^3} \\implies 216^2 \\geq 144^3 / n \\implies n \\leq \\frac{144^3}{216^2}.\n   \\]\n   Simplifying the right-hand side, we get\n   \\[\n   n \\leq \\frac{144^3}{216^2} = \\frac{2985984}{46656} = 64.\n   \\]\n   Therefore, the only possible value of \\(n\\) is 64.\n\n3. **Verification:**\n   We need to verify that \\(n=64\\) is indeed a valid solution. If \\(n=64\\), then the conditions become\n   \\[\n   \\sum_{i=1}^{64} a_i = 96, \\quad \\sum_{i=1}^{64} a_i^2 = 144, \\quad \\sum_{i=1}^{64} a_i^3 = 216.\n   \\]\n   If we assume that all \\(a_i\\) are equal, then \\(a_i = \\frac{96}{64} = \\frac{3}{2}\\). Substituting \\(a_i = \\frac{3}{2}\\) into the conditions, we get\n   \\[\n   \\sum_{i=1}^{64} \\frac{3}{2} = 64 \\cdot \\frac{3}{2} 