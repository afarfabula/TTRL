 4:\r\n        cycle = [4, 6]\r\n    elif units_digit_base == 5:\r\n        return 5\r\n    elif units_digit_base == 6:\r\n        return 6\r\n    elif units_digit_base == 7:\r\n        cycle = [7, 9, 3, 1]\r\n    elif units_digit_base == 8:\r\n        cycle = [8, 4, 2, 6]\r\n    elif units_digit_base == 9:\r\n        cycle = [9, 1]\r\n    \r\n    # Determine the position in the cycle\r\n    if len(cycle) == 2:\r\n        position = (b - 1) % 2\r\n    else:\r\n        position = (b - 1) % 4\r\n    \r\n    return cycle[position]\r\n\r\n# Find the units digit of 18^6\r\nunits_digit_18_6 = units_digit(18, 6)\r\n\r\n# Find the units digit of 17^19\r\nunits_digit_17_19 = units_digit(17, 19)\r\n\r\nprint((units_digit_18_6, units_digit_17_19))\n```\n```output\n(4, 3)\n```\nThe units digit of \\(18^6\\) is \\(\\boxed{4}\\) and the units digit of \\(17^{19}\\) is \\(\\boxed{3}\\).", 'Find the units digit of $19^8.$\n  \\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_\\_