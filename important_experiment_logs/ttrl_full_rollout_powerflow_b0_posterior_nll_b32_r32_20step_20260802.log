\n# Let's consider the boundary values for c and try to find the corresponding a and b\n# We will check the cases where c = 1, c = -1, a + b + c = 1, a + b + c = -1, and the vertex constraint\n\n# Case 1: c = 1\nc_val = 1\na_b_constraints = [\n    sp.Abs(a + b + 1) <= 1,\n    sp.Abs(1 - b**2 / (4 * a)) <= 1\n]\n\n# Solve for a and b\nsolutions = []\nfor constraint in a_b_constraints:\n    solutions.extend(sp.solve(constraint, (a, b), domain=sp.S.Reals))\n\n# Check the solutions\nmax_value = 0\nfor sol in solutions:\n    a_val, b_val = sol\n    if a_val.is_real and b_val.is_real:\n        value = sp.Abs(a_val) + sp.Abs(b_val) + sp.Abs(c_val)\n        if value > max_value:\n            max_value = value\n\n# Case 2: c = -1\nc_val = -1\na_b_constraints = [\n    sp.Abs(a + b - 1) <= 1,\n    sp.Abs(-1 - b**2 / (4 * a)) <= 1\n]\n\n# Solve for a and b\nsolutions = []\nfor constraint in a_b_constraints:\n    solutions.extend(sp.solve(constraint, (a, b), domain=sp.S.Reals))\n\n# Check the solutions\nfor sol in solutions:\n    a_val, b_val = sol\n    if a_val.is_real and b_val.is_real:\n        value = sp.Abs(a_val) + sp.Abs(b_val) + sp.Abs(c_val)\n        if value > max_value:\n            max_value = value\n\n# Case 3: a + b + c = 1, c = 1\nc_val = 1\na_b_constraints = [\n    sp.Abs(a + b + 1) <= 1,\n    sp.Abs(1 - b**2 / (4 * a)) <= 1\n]\n\n# Solve for a and b\nsolutions = []\nfor constraint in a_b_constraints:\n    solutions.extend(sp.solve(constraint, (a, b), domain=sp.S.Reals))\n\n# Check the solutions\nfor sol in solutions:\n    a_val, b_val = sol\n    if a_val.is_real and b_val.is_real:\n        value = sp.Abs(a_val) + sp.Abs(b_val) + sp.Abs(c_val)\n        if value > max_value:\n            max_value = value\n\n# Case 4: a + b + c = -1, c = -1\nc_val = -1\na_b_constraints = [\n    sp.Abs(a + b - 1) <= 1,\n    sp.Abs(-1 - b**2 / (4 * a)) <= 1\n]\n\n# Solve for a and b\nsolutions = []\nfor constraint in a_b_constraints:\n    solutions.extend(sp.solve(constraint, (a, b)