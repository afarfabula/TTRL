_values = values + interval_values\r\nmax_value = max(all_values)\r\n\r\n# Problem 4\r\n# This is the same as Problem 1\r\nsolutions_4 = solutions\r\n\r\nprint(f"Solutions to Problem 1: {solutions}")\r\nprint(f"Minimum value of Problem 2: {median}")\r\nprint(f"L', 'If $x$ is a positive integer, and $x^3 + x^2 + x = 114$, find $x$. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxed{}. \\boxe