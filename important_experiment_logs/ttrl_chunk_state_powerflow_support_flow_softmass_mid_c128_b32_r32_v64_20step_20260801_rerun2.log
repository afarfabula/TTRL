gth), above=true, Arrows(size=axisarrowsize));\n\n} else {\n\nxequals(0, ymin=ybottom, ymax=ytop, p=axispen, above=true, Arrows(size=axisarrowsize));\n\nyequals(0, xmin=xleft, xmax=xright, p=axispen, above=true, Arrows(size=axisarrowsize));\n\n}\n};\nrr_cartesian_axes(-8,4,-6,6);\nreal f(real x) {return (x^2+x-6)/(2*x+1);}\ndraw(graph(f,-8,-2.25));\ndraw(graph(f,-0.75,0.75));\ndraw(graph(f,1.5,4));\ndot((-3,0),red);\ndot((2,0),red);\ndot((-0.5,-7),red);\ndot((-0.5,3.5),red);[/asy]\nWhat is the value of $f(-2)+f(-1)+f(0)+f(1)+f(2)$? \\boxed{}. Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shayn\n Shay', 'The graph of $f(x)=\\frac{x^3-6x^2-13x}{x^2-5x-24}$ has vertical asymptotes $x=a$ and $x=b$, and horizontal asymptote $y=c$.  Find $a+b+c$.  \\boxed{}. Shay\nAssistant\nThe graph of $f(x)=\\frac{x^3-6x^2-13x}{x^2-5x-24}$ has vertical asymptotes $x=a$ and $x=b$, and horizontal asymptote $y=c$.  Find $a+b+c$. Shay\nAssistant\nThe graph of $f(x)=\\frac{x^3-6x^2-13x}{x^2-5x-24}$ has vertical asymptotes $x=a$ and $x=b$, and horizontal asymptote $y=c$.  Find $a+b+c$. Shay\nAssistant\nThe graph of $f(x)=\\frac{x^3-6x^2-13x}{x^2-5x-24}$ has vertical asymptotes $x=a$ and $x=b$, and horizontal asymptote $y=c$.  Find $a+b+c$. Shay\nAssistant\nThe graph of $f(x)=\\frac{x^3-6x^2-13x}{x^2-5x-24}$